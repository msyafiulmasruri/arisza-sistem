# Backend FastAPI / Vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Buat nilai acak dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
SESSION_TTL_SECONDS=43200
SPACE_URL=https://NAMAKAMU-NAMASPACE.hf.space
SPACE_API_KEY=kunci-yang-sama-dengan-API_KEY-di-Space
# Hanya bila Space bersifat private:
HF_SPACE_TOKEN=
# Alamat frontend (pisahkan dengan koma bila ada lebih dari satu)
FRONTEND_ORIGIN=https://nama-frontend.vercel.app,http://localhost:5173
BATAS_MACET_MENIT=30
MAKS_BARIS_IMPOR=5000
