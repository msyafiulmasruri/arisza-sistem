# Backend FastAPI - konfigurasi development lokal.
# Untuk development lokal dengan AI Service production di Hugging Face Spaces,
# isi SPACE_URL dengan alamat Space milikmu.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Buat secret acak dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
SESSION_TTL_SECONDS=43200

# Gunakan URL Hugging Face Space production. Untuk AI Service lokal, gunakan http://127.0.0.1:7860.
SPACE_URL=https://NAMA-SPACE.hf.space
# Harus sama persis dengan API_KEY pada Secrets Hugging Face Space.
SPACE_API_KEY=ganti-dengan-api-key-yang-sama-dengan-test-ai
# Isi hanya jika Hugging Face Space bersifat private.
HF_SPACE_TOKEN=

# Alamat frontend lokal.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

BATAS_MACET_MENIT=30
MAKS_BARIS_IMPOR=5000
