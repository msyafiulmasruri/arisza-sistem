# Backend FastAPI - konfigurasi development lokal
# Salin file ini menjadi .env, lalu isi nilai yang benar.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Buat secret acak dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
SESSION_TTL_SECONDS=43200

# Untuk menjalankan test-ai secara lokal:
SPACE_URL=http://127.0.0.1:7860
# Harus sama persis dengan API_KEY pada test-ai/.env
SPACE_API_KEY=ganti-dengan-api-key-yang-sama-dengan-test-ai
# Isi hanya jika mengakses Hugging Face Space private
HF_SPACE_TOKEN=

# Alamat frontend lokal
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

BATAS_MACET_MENIT=30
MAKS_BARIS_IMPOR=5000
