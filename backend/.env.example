# Isi di Vercel > Project > Settings > Environment Variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ADMIN_PASSWORD=kata-sandi-masuk-dasbor
SPACE_URL=https://NAMAKAMU-NAMASPACE.hf.space
SPACE_API_KEY=kunci-yang-sama-dengan-API_KEY-di-Space
# Hanya bila Space bersifat private:
HF_SPACE_TOKEN=
# Alamat frontend (pisahkan dengan koma bila lebih dari satu)
FRONTEND_ORIGIN=https://nama-frontend.vercel.app,http://localhost:5173
