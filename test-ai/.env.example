# Arisza AI Service - hanya secrets untuk development lokal.
# Pada Hugging Face Spaces, masukkan nilai ini melalui Settings > Variables and secrets.

# Harus sama persis dengan SPACE_API_KEY pada backend.
API_KEY=ganti-dengan-api-key-yang-sama-dengan-backend

# Database Neon yang sama dengan backend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Token Hugging Face dengan akses ke meta-llama/Llama-3.2-3B-Instruct.
HF_TOKEN=hf_ganti_dengan_token_kamu
